{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Realm Docs",
  "colors": {
    "primary": "#248573",
    "light": "#248573",
    "dark": "#248573"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "User Guide",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart"
            ]
          },
          {
            "group": "Chat",
            "pages": [
              "chat/overview",
              "chat/effective-queries",
              "chat/citations",
              "chat/research-mode",
              "chat/file-attachments",
              "chat/filters",
              "chat/special-features"
            ]
          },
          {
            "group": "Search",
            "pages": [
              "search/overview",
              "search/filters-and-sorting",
              "search/query-syntax",
              "search/previews"
            ]
          },
          {
            "group": "Agents",
            "pages": [
              "agents/overview",
              "agents/creating-agents",
              "agents/writing-instructions",
              "agents/knowledge-selection",
              "agents/triggers",
              "agents/tools-and-actions",
              "agents/slack-channels"
            ]
          },
          {
            "group": "AI Models",
            "pages": [
              "ai-models/available-models"
            ]
          },
          {
            "group": "RFP Automation",
            "pages": [
              "rfp/filling-rfps",
              "rfp/formatting"
            ]
          },
          {
            "group": "Curation",
            "pages": [
              "curation/verifying-and-hiding"
            ]
          },
          {
            "group": "Use Realm in Slack and Browser",
            "pages": [
              "integrations/slack-app",
              "integrations/chrome-extension"
            ]
          }
        ]
      },
      {
        "tab": "Admin Guide",
        "groups": [
          {
            "group": "Administration",
            "pages": [
              "admin/overview"
            ]
          },
          {
            "group": "Connectors",
            "pages": [
              "admin/connectors/overview",
              "admin/connectors/slack",
              "admin/connectors/google-drive",
              "admin/connectors/hubspot",
              "admin/connectors/salesforce",
              "admin/connectors/jira",
              "admin/connectors/confluence",
              "admin/connectors/zendesk",
              "admin/connectors/sharepoint",
              "admin/connectors/freshdesk",
              "admin/connectors/notion",
              "admin/connectors/intercom",
              "admin/connectors/web-scraping"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Documentation",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": {
              "source": "realm-api-docs.json",
              "directory": "api-reference"
            }
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Changelog",
          "href": "https://www.withrealm.com/changelog",
          "icon": "newspaper"
        },
        {
          "anchor": "Status",
          "href": "https://status.withrealm.com/",
          "icon": "signal-bars"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/realm-logo-black.png",
    "dark": "/logo/realm-logo-white.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@withrealm.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Realm",
      "href": "https://app.withrealm.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://linkedin.com/company/withrealm"
    }
  }
}
